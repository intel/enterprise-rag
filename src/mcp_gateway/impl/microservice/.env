## MCP Gateway Settings

# Internal EDP endpoint (cluster-internal)
EDP_ENDPOINT=

# Internal ChatQnA router endpoint (cluster-internal)
# Leave empty when ChatQnA pipeline is not deployed
CHATQNA_ENDPOINT=

# MCP server identity
MCP_SERVER_PORT=8000

# OAuth 2.0 resource-server settings (injected at runtime via Helm values).
# Callers present their own Keycloak token; the gateway accepts only tokens from this
# issuer that carry this audience.
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_RESOURCE_URL=

## Uncomment to change log level
# ERAG_LOGGER_LEVEL=INFO
