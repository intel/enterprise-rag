FROM text-compression-base:latest

COPY compliance /compliance

WORKDIR /compliance/ospdt
COPY Dockerfile .
COPY uv.lock .

# CMD from base Dockerfile
WORKDIR /home/user/comps/text_compression
# Run as the same non-root user as the base image (explicit for image scanners)
USER user

CMD ["python", "erag_text_compression_microservice.py"]
