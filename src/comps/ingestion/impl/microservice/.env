## Ingestion Microservice Settings
# VECTOR_STORE allowed values: redis, redis-cluster, milvus, mssql, pgvector
VECTOR_STORE='redis'

## Vector Store Settings
REDIS_URL='redis://localhost:6379/0'
# Allowed values: FLAT, HNSW (Redis also supports SVS-VAMANA; Milvus also supports IVF_FLAT, AUTOINDEX)
VECTOR_ALGORITHM="FLAT"
# Embedding dimension, must match the model used. For example bge-base-en-v1.5=768, bge-large-en-v1.5=1024
VECTOR_DIMS="768"
# VECTOR_DATATYPE allowed values: BFLOAT16, FLOAT16, FLOAT32, FLOAT64 (Milvus always uses FLOAT32)
VECTOR_DATATYPE="FLOAT32"
# VECTOR_DISTANCE_METRIC allowed values: L2 (euclidean), IP (inner product), COSINE
VECTOR_DISTANCE_METRIC="COSINE"
### For HNSW Algorithm additional settings are available
VECTOR_HNSW_M="32"
VECTOR_HNSW_EF_CONSTRUCTION="32"
VECTOR_HNSW_EF_RUNTIME="32"
VECTOR_HNSW_EPSILON="0.01"

## Milvus Settings (used when VECTOR_STORE='milvus')
# MILVUS_URL=http://localhost:19530
# MILVUS_USERNAME=""
# MILVUS_PASSWORD=""
# MILVUS_DB=default
# MILVUS_VECTOR_COLLECTION=vdb
# MILVUS_TIMEOUT=30

## Uncomment to change the microservice port
#INGESTION_USVC_PORT=6120

## Uncomment to change the microservice log level
# ERAG_LOGGER_LEVEL=INFO
