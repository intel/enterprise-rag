## System Fingerprint Microservice Settings
SYSTEM_FINGERPRINT_POSTGRES_HOST=127.0.0.1
SYSTEM_FINGERPRINT_POSTGRES_PORT=5432

# Proxy settings
http_proxy=""
https_proxy=""
no_proxy=""

SYSTEM_FINGERPRINT_TEMPLATE_LANGUAGE="en" # only "en" and "pl" are supported

## Uncomment to change the microservice port
# SYSTEM_FINGERPRINT_USVC_PORT=6012

SYSTEM_FINGERPRINT_DATABASE_NAME="system_fingerprint"
SYSTEM_FINGERPRINT_POSTGRES_USER="postgres"
SYSTEM_FINGERPRINT_POSTGRES_PASSWORD="postgres" # nosemgrep

## Composite-key dimensions (single-pipeline, global tenant for now)
SYSTEM_FINGERPRINT_PIPELINE="default"
SYSTEM_FINGERPRINT_TENANT="_global"
