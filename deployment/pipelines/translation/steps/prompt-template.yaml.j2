{# Translation Prompt Template step. Unlike the shared step it sets no paramsKind, #}
{# so the router does not overwrite the translation template that language      #}
{# detection sends with the fingerprint's stored ChatQnA prompt_template.        #}
step:
  name: PromptTemplate
  dependency: Hard
  data: $response
  internalService:
    serviceName: prompt-template-svc
    config:
      endpoint: /v1/prompt_template
resources:
  prompt-template-usvc:
    replicas: 1
    resources:
      requests:
        cpu: 1
        memory: 2Gi
      limits:
        cpu: 4
        memory: 2Gi
