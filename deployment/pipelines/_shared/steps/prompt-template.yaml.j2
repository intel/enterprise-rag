{# Shared Prompt Template step - format context and query for the LLM. #}
{# Translation overrides it with pipelines/translation/steps/.          #}
step:
  name: PromptTemplate
  dependency: Hard
  data: $response
  internalService:
    serviceName: prompt-template-svc
    config:
      endpoint: /v1/prompt_template
      paramsKey: prompt_template
      paramsKind: prompt_template
resources:
  prompt-template-usvc:
    replicas: 1
    resources:
      requests:
        cpu: 1
        memory: 2Gi
      limits:
        cpu: 4
        memory: 2Gi
