---
# Data Report — generated by app_data_consistency/tasks/report.yaml
#
# What each store held when the run finished, and how it was counted. No
# comparison and no verdict: a single snapshot has nothing to be measured
# against. The comparison across an upgrade lives in upgrade-report-<ts>.yaml.
metadata:
  generated: "{{ _report_timestamp }}"
  action: "{{ component_action | default('install') }}"
  environment: "{{ env_dir | basename }}"
  solution_version: "{{ solution_version | default('unknown') }}"
  pipeline_type: "{{ pipeline_type | default('chatqna') }}"

stores:
{% for store, data in _data_snapshot.items() %}
  {{ store }}:
    count: {{ data.count }}
    status: "{{ data.status }}"
    method: "{{ data.method }}"
{% if data.reason is defined %}
    reason: "{{ data.reason }}"
{% endif %}
{% endfor %}
