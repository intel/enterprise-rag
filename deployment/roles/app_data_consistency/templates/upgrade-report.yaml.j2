---
# Upgrade Report — generated by app_data_consistency/tasks/report.yaml
metadata:
  generated: "{{ _report_timestamp }}"
  action: upgrade
  environment: "{{ env_dir | basename }}"
  solution_version: "{{ solution_version | default('unknown') }}"
  pipeline_type: "{{ pipeline_type | default('chatqna') }}"

pre_snapshot:
{% for store, data in _upgrade_pre_snapshot.items() %}
  {{ store }}:
    count: {{ data.count }}
    status: "{{ data.status }}"
    method: "{{ data.method }}"
{% if data.reason is defined %}
    reason: "{{ data.reason }}"
{% endif %}
{% endfor %}

post_snapshot:
{% for store, data in _upgrade_post_snapshot.items() %}
  {{ store }}:
    count: {{ data.count }}
    status: "{{ data.status }}"
    method: "{{ data.method }}"
{% if data.reason is defined %}
    reason: "{{ data.reason }}"
{% endif %}
{% endfor %}

consistency:
  verdict: "{{ _upgrade_consistency_result.verdict }}"
  timestamp: "{{ _upgrade_consistency_result.timestamp }}"
  stores:
{% for store, data in _upgrade_consistency_result.stores.items() %}
    {{ store }}:
      pre: {{ data.pre }}
      post: {{ data.post }}
      delta: {{ data.delta }}
      verdict: "{{ data.verdict }}"
{% endfor %}
{% if _upgrade_consistency_result.violations | length > 0 %}
  violations:
{% for v in _upgrade_consistency_result.violations %}
    - "{{ v }}"
{% endfor %}
{% else %}
  violations: []
{% endif %}
