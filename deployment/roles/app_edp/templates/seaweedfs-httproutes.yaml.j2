HTTPRoutes for SeaweedFS (S3 API + admin browser UI).

Hostnames (subdomain mode):
  - s3.<base_domain_name>          → seaweedfs-s3:8333
  - seaweedfs.<base_domain_name>   → seaweedfs-admin:23646

Parent ref is the core Envoy Gateway. The S3 route binds whichever listener claims
its hostname (_edp_s3_section, resolved in tasks/s3_listener_section.yaml): the
wildcard '*.<base_domain_name>' one normally, the apex one in path mode, and the
dedicated S3 listener when the core installer created one for ONTAP - that listener
claims s3.<base_domain_name> exactly, which wins over the wildcard by specificity and
would otherwise leave this route Accepted=False / NoMatchingListenerHostname.

No auth attached - S3 clients use SigV4, admin UI has its own session layer.
#}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: seaweedfs-s3-route
  namespace: {{ edp_seaweedfs_namespace }}
  labels:
    app.kubernetes.io/name: seaweedfs-s3
    app.kubernetes.io/managed-by: ansible
spec:
  parentRefs:
    - name: {{ gateway_name }}
      namespace: {{ gateway_namespace }}
      sectionName: {{ _edp_s3_section }}
  hostnames:
    - "{{ _edp_s3_host }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
{% if routing_mode | default('subdomain') == 'path' %}
            value: {{ edp_s3_path_prefix | default('/s3') }}
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
{% else %}
            value: /
{% endif %}
      timeouts:
        request: 3600s
        backendRequest: 3600s
      backendRefs:
        - name: seaweedfs-s3
          port: 8333
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: seaweedfs-admin-route
  namespace: {{ edp_seaweedfs_namespace }}
  labels:
    app.kubernetes.io/name: seaweedfs-admin
    app.kubernetes.io/managed-by: ansible
spec:
  parentRefs:
    - name: {{ gateway_name }}
      namespace: {{ gateway_namespace }}
      sectionName: {{ 'https-apex' if routing_mode | default('subdomain') == 'path' else 'https' }}
  hostnames:
{% if routing_mode | default('subdomain') == 'path' %}
    - "{{ base_domain_name }}"
{% else %}
    - "{{ (edp_ui_browser_domain_prefix | default('seaweedfs')) ~ '.' ~ base_domain_name }}"
{% endif %}
  rules:
    - matches:
        - path:
            type: PathPrefix
{% if routing_mode | default('subdomain') == 'path' %}
            value: {{ edp_seaweedfs_path_prefix | default('/seaweedfs') }}
{% else %}
            value: /
{% endif %}
      backendRefs:
        - name: seaweedfs-admin
          port: 23646
---
# Bypass gateway-level JWT for the S3 API HTTPRoute.
# S3 clients use SigV4 signatures (AWS signature v4), not OIDC tokens.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: seaweedfs-s3-no-auth
  namespace: {{ edp_seaweedfs_namespace }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: seaweedfs-s3-route
---
# Bypass gateway-level JWT for the admin UI.
# seaweedfs-admin has its own session auth; gateway-level JWT would
# block the login page itself.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: seaweedfs-admin-no-auth
  namespace: {{ edp_seaweedfs_namespace }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: seaweedfs-admin-route
