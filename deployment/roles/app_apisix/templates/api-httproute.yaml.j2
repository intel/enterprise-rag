---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ apisix_api_route_name }}
  namespace: {{ apisix_namespace }}
  labels:
    app.kubernetes.io/name: apisix
    app.kubernetes.io/managed-by: ansible
spec:
  parentRefs:
    - {{ gateway_publish.parent_ref | to_json }}
  hostnames:
    - {{ ui_domain_name | quote }}
  rules:
    - matches:
{% for path in apisix_api_paths %}
        - path:
            type: PathPrefix
            value: {{ path | quote }}
{% endfor %}
      backendRefs:
        - name: {{ apisix_helm_release_name }}-gateway
          port: 80
